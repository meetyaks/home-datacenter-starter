# A disposable Debian host with systemd, for exercising the CoreDNS role.
#
# ⚠️ SEPARATE FROM Dockerfile.systemd ON PURPOSE, AND THE DIFFERENCE IS WHAT
# IT DOES NOT CONTAIN. The caddy image installs a broad toolchain; this one
# must ship WITHOUT `dig`, because roles/coredns/tasks/verifier-prereq.yml is
# supposed to install it and a preinstalled dig would turn that proof into a
# false positive. tests/run-coredns-role.sh asserts the absence before it
# starts, so this cannot rot unnoticed.
#
# ⚠️ AND WITHOUT systemd-resolved, so port 53 is genuinely free. The role
# binds the real production port rather than a test-only one.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# Deliberately NOT installed: bind9-dnsutils / dnsutils (the role installs it),
# and anything that would occupy :53.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      python3 python3-apt python3-yaml \
      ca-certificates curl iproute2 procps \
      ansible \
 && rm -rf /var/lib/apt/lists/*

# Trim units that cannot work in a container, and resolved so :53 stays free.
RUN find /etc/systemd/system /lib/systemd/system \
      -path '*.wants/*' \
      \( -name '*getty*' -o -name '*udev*' -o -name '*mount*' \
         -o -name '*swap*' -o -name '*networkd*' -o -name '*resolved*' \) \
      -exec rm -f {} + 2>/dev/null || true

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
