# A disposable Debian host with systemd, for exercising the Semaphore role.
#
# ⚠️ WHAT IT DELIBERATELY DOES NOT CONTAIN: semaphore itself, any service
# account, any database. The role must create all of it, and the harness
# asserts their absence before the role runs — otherwise the test proves the
# container's contents rather than the role's behaviour.
#
# ⚠️ IT DOES CONTAIN the tools the role resolves on the service PATH
# (ansible-playbook, ansible-galaxy, python3, git, ssh) plus sqlite3 for the
# backup/restore test and sudo for become_user, because those are
# prerequisites of the controller rather than things this role installs.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      python3 python3-apt python3-yaml \
      ansible \
      ca-certificates curl git openssh-client \
      sqlite3 iproute2 procps sudo \
 && rm -rf /var/lib/apt/lists/*

# Trim units that cannot work in a container.
RUN find /etc/systemd/system /lib/systemd/system \
      -path '*.wants/*' \
      \( -name '*getty*' -o -name '*udev*' -o -name '*mount*' \
         -o -name '*swap*' -o -name '*networkd*' -o -name '*resolved*' \) \
      -exec rm -f {} + 2>/dev/null || true

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
