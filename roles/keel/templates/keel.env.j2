# Rendered by roles/keel from Ansible Vault. DO NOT EDIT ON THE HOST.
# 0600 root:root. Never copy this file, never echo it, never paste it anywhere.
# Regenerate with: ansible-playbook playbooks/keel.yml --tags secrets

KEEL_IMAGE={{ keel_gateway_image }}
KEEL_WEB_IMAGE={{ keel_web_image }}

KEEL_DATA_ROOT={{ keel_data_root }}
KEEL_SECRETS_DIR={{ keel_secrets_dir }}

# PostgreSQL server configuration and TLS material, mounted read-only at
# /etc/keel-pg. Holds server.crt, server.key (0600 uid 999) and pg_hba.conf.
KEEL_PG_CONF_DIR={{ keel_pg_conf_dir }}

# Optional initial platform_admin, linked on first OIDC login. Empty means the
# instance comes up with no admin and one is granted out of band.
KEEL_BOOTSTRAP_ADMIN_EMAIL={{ keel_bootstrap_admin_email | default('') }}

# PERMANENT INSTALLATION IDENTITY — the id this installation's initial tenant is
# seeded at. Immutable: upgrades reuse it, reruns never regenerate it, a rebuilt
# machine restores it, and a database restore must use the value that produced
# the dump. Validated for shape in preflight; never generated here.
KEEL_DEFAULT_TENANT_ID={{ keel_vault_default_tenant_id }}

KEEL_ADMIN_DB_PASSWORD={{ keel_vault_admin_db_password }}
KEEL_APP_DB_PASSWORD={{ keel_vault_app_db_password }}

KEEL_BLOB_BUCKET={{ keel_blob_bucket }}
KEEL_BLOB_ACCESS_KEY={{ keel_vault_blob_access_key }}
KEEL_BLOB_SECRET_KEY={{ keel_vault_blob_secret_key }}

KEEL_JWT_ISSUER={{ keel_jwt_issuer }}
KEEL_JWT_AUDIENCE={{ keel_jwt_audience }}
KEEL_CORS_ORIGINS={{ keel_cors_origins }}

KEEL_OIDC_ISSUER={{ keel_oidc_issuer }}
KEEL_OIDC_CLIENT_ID={{ keel_oidc_client_id }}
KEEL_OIDC_CLIENT_SECRET={{ keel_vault_oidc_client_secret }}

KEEL_VAULT_MASTER_KEY={{ keel_vault_master_key }}
KEEL_MFA_MASTER_KEY={{ keel_vault_mfa_master_key }}
