# MANAGED BY roles/ci_runner — the runner reads this file from its own root and
# applies it to the service and to every job.
#
# ⚠️ NO SECRETS HERE, EVER. This file is world-readable to anything that can
# read the runner directory, it is copied into every job's environment, and it
# is exactly the kind of place a production credential ends up by accident. The
# CI VM is built so that there is no production credential to put here.

# The per-job hygiene hooks. Without these two lines the cleanup scripts exist
# but never run, so their presence on disk proves nothing — this is what makes
# them load-bearing.
ACTIONS_RUNNER_HOOK_JOB_STARTED={{ ci_runner_hook_dir }}/job-started.sh
ACTIONS_RUNNER_HOOK_JOB_COMPLETED={{ ci_runner_hook_dir }}/job-completed.sh

# A package store that survives the workspace wipe, so a clean checkout is not
# also a cold install.
PNPM_HOME={{ ci_runner_cache_dir }}/pnpm
PNPM_STORE_DIR={{ ci_runner_cache_dir }}/pnpm/store
XDG_CACHE_HOME={{ ci_runner_cache_dir }}/xdg

DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
