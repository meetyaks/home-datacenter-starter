#!/usr/bin/env bash
# MANAGED BY roles/ci_runner — ACTIONS_RUNNER_HOOK_JOB_STARTED.
#
# Runs in the guest, as {{ ci_runner_user }}, before every job's first step.
# Two jobs: give the job a clean workspace, and REFUSE TO RUN if the isolation
# this whole role exists for has been undone.
set -uo pipefail

RUNNER_WORK='{{ ci_runner_work }}'
CACHE_DIR='{{ ci_runner_cache_dir }}'

fail() { echo "::error title=CI isolation::$*"; exit 1; }

# ── The isolation self-check ────────────────────────────────────────────────
#
# ⚠️ THIS IS THE RUNTIME HALF OF THE ISOLATION CLAIM. tests/ proves the VM is
# built without a path to production; this proves it at the moment code is about
# to run, which is the only moment that matters. If someone adds a bind-mount to
# "just share the pnpm cache", the next job fails here instead of quietly
# handing the repository's own CI a copy of the lab's JWT signing key.
[ -e /srv/data ]            && fail "/srv/data is visible inside the CI VM. A host path has been mounted in. Refusing to run."
[ -S /var/run/docker.sock ] || fail "no Docker socket in the guest — the CI daemon is not running."

# The guest's own socket must be the guest's. A host socket bind-mounted in
# would answer with the HOST's containers, production Keel among them.
if command -v docker >/dev/null 2>&1; then
  names="$(docker ps --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
  case "$names" in
    *keel-gateway*|*keel-postgres*|*keel-caddy*|*keel-minio*)
      fail "production Keel containers are visible from the CI runner. Refusing to run." ;;
  esac
fi

# Production must be unreachable by ADDRESS as well as by mount. The host's own
# LAN address runs Caddy on 443 and is inside 10.0.0.0/24, which the host's
# `inet ci_egress` table drops. Reaching it would mean the policy is not loaded
# — so this checks the control is in force instead of assuming it.
#
# `/dev/tcp` with a timeout, not curl: no dependency, and a DROP shows up as the
# timeout rather than a connection refused.
for hp in {% for p in ci_isolation_denied_probes %}'{{ p }}' {% endfor %}; do
  host="${hp%:*}"; port="${hp##*:}"

  # ⚠️ A PROBE THAT CANNOT RESOLVE PASSES, AND MEANS NOTHING. `/dev/tcp` to an
  # unresolvable name fails exactly like a dropped packet, so if this list is
  # ever rendered from an inventory NAME — the controller's `ansible_host` is
  # `dc1-x86`, which does not resolve inside the guest — every check here would
  # report the host as unreachable while nothing had been tested. A negative
  # result is only evidence when the target was addressable.
  case "$host" in
    [0-9]*.[0-9]*.[0-9]*.[0-9]*) : ;;
    *) fail "isolation probe '${hp}' is not an IP address. An unresolvable target cannot prove anything; set ci_isolation_denied_probes to addresses." ;;
  esac

  if timeout 4 bash -c "exec 3<>/dev/tcp/${host}/${port}" 2>/dev/null; then
    fail "${hp} answered from inside the CI VM. The host egress policy is not in force."
  fi
done

# ── Stale workspaces from OTHER jobs ────────────────────────────────────────
#
# ⚠️ NOT THIS JOB'S WORKSPACE, AND THAT DISTINCTION COST THE FIRST CI RUN.
# The runner creates the job's working directory BEFORE it invokes this hook.
# The first version of this script removed everything under _work, including
# that directory — so every step then died instantly with
#
#   An error occurred trying to start process '/usr/bin/docker' with working
#   directory '/home/ghrunner/_work/keel/keel'. No such file or directory
#
# Both jobs failed in under 20 seconds, having run no product code at all.
#
# So this removes the checkout trees of OTHER repositories and other branches —
# which is what stops one job inheriting another's node_modules, build output or
# stray credentials — and leaves the current one alone. Clearing the current
# workspace is the completed hook's job, once the runner has finished with it.
#
# The runner's own caches (_actions, _tool) and the pnpm store are kept
# deliberately: they hold no job state, and rebuilding them every run would
# triple the cycle time.
keep="$(basename "${RUNNER_WORKSPACE:-__none__}")"
if [ -d "$RUNNER_WORK" ]; then
  for d in "$RUNNER_WORK"/*; do
    [ -e "$d" ] || continue
    case "$(basename "$d")" in
      _actions|_tool|_temp) continue ;;
      "$keep")              continue ;;
      *) rm -rf "$d" 2>/dev/null || true ;;
    esac
  done
  # _temp is scratch the runner recreates per job, and it is not the working
  # directory, so emptying it here is safe.
  rm -rf "${RUNNER_WORK:?}/_temp/"* 2>/dev/null || true
fi

mkdir -p "$CACHE_DIR/pnpm"
echo "CI isolation checks passed; workspace reset."
