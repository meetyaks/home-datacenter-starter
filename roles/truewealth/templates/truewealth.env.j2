# {{ ansible_managed }}
# TrueWealth runtime configuration for infra/dc1/compose.dc1.yml at
# {{ truewealth_commit }}. 0600 root:root — holds secrets from the vault.
#
# Images: local tags of archives loaded and identity-checked by
# roles/truewealth/tasks/images.yml (never pulled; `up --pull never`).
TW_WEB_IMAGE={{ truewealth_images.web.localTag }}
TW_WORKER_IMAGE={{ truewealth_images.worker.localTag }}
TW_COMPUTE_IMAGE={{ truewealth_images.compute.localTag }}
TW_MIGRATE_IMAGE={{ truewealth_images.migrator.localTag }}

TW_WEB_PORT={{ truewealth_web_loopback_port }}
TW_PUBLIC_URL=https://{{ truewealth_hostname }}
TW_INVITE_ONLY=1

TW_DB_PASSWORD={{ truewealth_vault_db_password }}
TW_KEY_SECRET={{ truewealth_vault_key_secret }}
TW_COMPUTE_CALLER_TOKEN={{ truewealth_vault_compute_token }}
TW_REDIS_PASSWORD_FILE={{ truewealth_redis_password_file }}
{% for k, v in truewealth_optional_env.items() %}
{% if v | string | length > 0 %}
{{ k }}={{ v }}
{% endif %}
{% endfor %}
