[Unit]
# Semaphore UI. Linux is NOT the production platform for this role — the
# controller is a Mac — but the disposable Linux container harness executes
# the whole role end to end in CI, and it cannot test restart-before-
# verification, idempotence or health without a real service manager.
Description=Semaphore UI (DC1 control plane)
After=network-online.target
Wants=network-online.target

[Service]
# ⚠️ Type=simple, NOT notify. Semaphore does not implement sd_notify; a
# notify unit waits for a readiness message that never arrives and is then
# killed as failed. The CoreDNS role lost a deployment to exactly this.
Type=simple
User={{ semaphore_user }}
Group={{ semaphore_group }}
WorkingDirectory={{ semaphore_state_dir }}

# A daemon inherits no login shell here either.
Environment=PATH={{ semaphore_path_entries | join(':') }}
Environment=HOME={{ semaphore_state_dir }}

ExecStart={{ semaphore_bin_link }} server --config {{ semaphore_config_path }}

# Graceful stop, then escalate — matching the launchd ExitTimeOut.
KillSignal=SIGTERM
TimeoutStopSec=30

# Bounded restart, so a daemon that cannot start does not spin.
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ semaphore_state_dir }} {{ semaphore_log_dir }}

StandardOutput=append:{{ semaphore_log_dir }}/semaphore.log
StandardError=append:{{ semaphore_log_dir }}/semaphore.err

[Install]
WantedBy=multi-user.target
