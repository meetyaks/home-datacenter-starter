# ─────────────────────────────────────────────────────────────────────────────
# GENERATED BY roles/coredns — DO NOT EDIT ON THE HOST.
#
# Every value comes from roles/coredns/defaults/main.yml and this node's
# inventory. An edit made here is lost on the next run, and worse, it is lost
# SILENTLY — which is the failure this file exists to end: dc1.lan used to be
# one hand-written /etc/hosts line on one workstation.
#
# node: {{ coredns_node_name }}
# zone: {{ coredns_zone }}
# ─────────────────────────────────────────────────────────────────────────────

# ── THE AUTHORITATIVE HALF ──────────────────────────────────────────────────
#
# This server block answers for {{ coredns_zone }} out of the zone file and
# NEVER forwards it. An unknown name under {{ coredns_zone }} must come back
# as an authoritative NXDOMAIN rather than being asked of a public resolver,
# which would leak internal names and could return somebody else's answer.
{{ coredns_zone }}:{{ coredns_dns_port }} {
{% for addr in coredns_bind_addresses %}
    bind {{ addr }}
{% endfor %}

    # LAN and loopback only; everything else is refused rather than answered.
    acl {
{% for net in coredns_allowed_networks %}
        allow net {{ net }}
{% endfor %}
        block
    }

    file {{ coredns_zone_file }}

    cache {{ coredns_cache_ttl }}
    health {{ coredns_health_address }}
    ready {{ coredns_ready_address }}

    # ⚠️ NO QUERY CONTENTS BEYOND NAMES, AND NO SECRETS ANYWHERE NEAR THIS.
    # DNS logs are names and client addresses; nothing in this role has a
    # credential to leak into them
    # (enforced: tests/dns-zone.yml "the configuration carries no secret").
    log
    errors
}

# ── THE FORWARDING HALF ─────────────────────────────────────────────────────
#
# ⚠️ UPSTREAMS ARE EXPLICIT PUBLIC RESOLVERS, AND THE ROUTER IS NOT AMONG
# THEM. 10.0.0.1 is about to be configured to forward TO this service. If this
# block forwarded back to 10.0.0.1, every external cache miss would bounce
# between the two until one of them gave up — a self-inflicted outage that
# only appears once the router change lands, i.e. after this looks fine.
#
# ⚠️ `.:53` WITH NO SPACE. A server block header is `ZONE...[:PORT]`, so
# `. :53` is read as TWO zones — `.` and `:53` — and CoreDNS refuses to start
# with "zone is not a valid domain name". That is exactly how this was
# written first, and no amount of asserting on the rendered text found it:
# every structural check passed on a file the daemon would not load. It was
# caught by starting the real binary against the rendered config, which is
# why tests/run-dns-corefile-parse.sh exists.
.:{{ coredns_dns_port }} {
{% for addr in coredns_bind_addresses %}
    bind {{ addr }}
{% endfor %}

    acl {
{% for net in coredns_allowed_networks %}
        allow net {{ net }}
{% endfor %}
        block
    }

    forward . {{ coredns_upstreams | join(' ') }}

    cache {{ coredns_cache_ttl }}
    errors
}
