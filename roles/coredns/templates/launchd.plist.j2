<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ───────────────────────────────────────────────────────────────────────────
  GENERATED BY roles/coredns — DO NOT EDIT ON THE HOST.

  The LAN's primary resolver, on {{ coredns_node_name }}.

  ⚠️ KeepAlive AND RunAtLoad ARE BOTH TRUE HERE, WHICH IS THE EXACT OPPOSITE
  OF roles/keel_reconcile'S PLIST — AND THE DIFFERENCE IS DELIBERATE.

  The reconciler forbids KeepAlive because a failed DEPLOYMENT must not be
  retried forever: its attempt ledger bounds retries at two, and a KeepAlive
  loop would defeat that bound and bury the one informative failure. It
  forbids RunAtLoad because the first reconciliation of a release should be
  watched by a person.

  Neither reason applies to a resolver. This is a long-running service with no
  ledger and no deployment semantics; if it dies, the correct response is to
  start it again immediately, and if the node reboots, name resolution for the
  whole LAN must come back without anybody logging in. A resolver that waits
  for a human is a resolver that is down.

  ⚠️ SO DO NOT "MAKE THE TWO PLISTS CONSISTENT". They are inconsistent on
  purpose, and tests/dns-zone.yml asserts THIS one keeps KeepAlive while
  tests/controller-scheduler.yml asserts the reconciler's never gains it.
  ───────────────────────────────────────────────────────────────────────────
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ coredns_launchd_label }}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ coredns_bin_dir }}/coredns</string>
    <string>-conf</string>
    <string>{{ coredns_corefile }}</string>
  </array>

  <!--
    Runs as root: binding port 53 is privileged, and a launchd system daemon
    is the supported way to do that on macOS. The process reads two
    root-owned files and holds no credential of any kind.
  -->
  <key>UserName</key>
  <string>root</string>

  <key>WorkingDirectory</key>
  <string>{{ coredns_conf_dir }}</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!--
    ⚠️ EXPLICIT, PROTECTED FILES. Without these, output goes to the unified
    log where it is mixed with everything else on the machine. DNS logs are
    query names and client addresses — no secret from this role can reach
    them, because this role has none.
  -->
  <key>StandardOutPath</key>
  <string>{{ coredns_log_dir }}/coredns.log</string>
  <key>StandardErrorPath</key>
  <string>{{ coredns_log_dir }}/coredns.err</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
