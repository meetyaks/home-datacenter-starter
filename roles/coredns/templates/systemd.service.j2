# GENERATED BY roles/coredns — DO NOT EDIT ON THE HOST.
#
# The LAN's secondary resolver, on {{ coredns_node_name }}. Same zone content
# as the primary, rendered from the same variables — not transferred from it.
[Unit]
Description=CoreDNS, authoritative for {{ coredns_zone }}
Documentation=https://coredns.io
# ⚠️ network-ONLINE, not network.target. The service binds an explicit
# address rather than the wildcard, so it cannot start before that address is
# actually configured — with network.target it would fail at boot and need a
# manual start, which is exactly when nobody is watching.
After=network-online.target
Wants=network-online.target

[Service]
# ⚠️ NO `Type=notify`. CoreDNS does not implement sd_notify, so notify would
# leave systemd waiting for a readiness message that never arrives and the
# unit would time out at boot. The default simple type is what upstream's own
# unit uses; readiness is observable through the `ready` plugin instead.
Type=simple

# ⚠️ A DEDICATED UNPRIVILEGED ACCOUNT PLUS ONE CAPABILITY, NOT root. Binding
# port 53 is the only privileged thing this process does, so it is granted
# exactly that and nothing else.
User={{ coredns_linux_user }}
Group={{ coredns_linux_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart={{ coredns_bin_dir }}/coredns -conf {{ coredns_corefile }}
ExecReload=/bin/kill -SIGUSR1 $MAINPID

# ⚠️ RESTARTED ON FAILURE, FOR THE SAME REASON THE launchd DAEMON SETS
# KeepAlive: if the LAN's resolver dies, the right response is to start it
# again, not to wait for a person. RestartSec keeps a genuinely broken
# configuration from spinning.
Restart=on-failure
RestartSec=5s

# Output goes to the journal; this unit writes no file of its own, so it needs
# no writable path. DNS logs are query names and client addresses — no secret
# from this role can reach them, because this role has none.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
