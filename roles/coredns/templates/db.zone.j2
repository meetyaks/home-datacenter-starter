; ───────────────────────────────────────────────────────────────────────────
; GENERATED BY roles/coredns — DO NOT EDIT ON THE HOST.
;
; The records come from `coredns_zone_records` in
; roles/coredns/defaults/main.yml, which is the ONLY copy. Both resolvers
; render this same file, so there is no primary/secondary drift to reconcile
; and no AXFR to break.
;
; ⚠️ THE SERIAL IS DERIVED FROM THE RECORD CONTENT, NOT FROM THE CLOCK. A
; timestamp serial would differ between the two nodes simply because they were
; deployed a minute apart, and "identical on both nodes" is a property this
; repository tests
; (enforced: tests/dns-zone.yml "both nodes render byte-identical zones").
; Change a record and the serial changes with it; change nothing and a
; redeploy is a genuine no-op.
;
; ⚠️ `keel.dc1.lan` IS NOT HERE AND MUST NOT BE ADDED. It is the reserved
; production identity; DEV is keel-dev.dc1.lan
; (enforced: tests/dns-zone.yml "keel.dc1.lan is absent from the zone").
; ───────────────────────────────────────────────────────────────────────────
$ORIGIN {{ coredns_zone }}.
$TTL {{ coredns_record_ttl }}

@   IN  SOA {{ coredns_soa_ns }} {{ coredns_soa_contact }} (
            {{ (coredns_zone_records | to_json | hash('sha1'))[:8] | int(base=16) }} ; serial, derived from the records above
            {{ coredns_soa_refresh }} ; refresh
            {{ coredns_soa_retry }} ; retry
            {{ coredns_soa_expire }} ; expire
            {{ coredns_soa_minimum }} ; minimum
            )

@   IN  NS  {{ coredns_soa_ns }}

{% for r in coredns_zone_records | sort(attribute='name') %}
{{ "%-12s" | format(r.name) }} IN  A   {{ r.ip }}
{% endfor %}
